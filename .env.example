WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# Start OpenCode separately with: opencode serve
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Optional: force a specific model for bridged prompts.
# Leave both empty to use the OpenCode server default.
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=

# Optional: only allow specific Enterprise WeChat user IDs.
# Comma-separated. Leave empty to allow all users who can reach the bot.
WECOM_ALLOWED_USER_IDS=

# Optional welcome message sent on enter_chat events.
WECOM_WELCOME_MESSAGE=你好，我已连接 OpenCode。请直接发送你的需求。

# Optional file path for persisted WeCom conversation -> OpenCode session mapping.
SESSION_STORE_PATH=.data/sessions.json
