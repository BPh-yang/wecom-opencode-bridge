# Select bot provider: wecom | feishu
BOT_PROVIDER=wecom

# Start OpenCode separately with: opencode serve
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Optional: force a specific model for bridged prompts.
# Leave both empty to use the OpenCode server default.
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=

# Optional: shared allowlist for the active provider.
# For WeCom use userid; for Feishu use open_id.
# Leave empty to allow all users who can reach the bot.
BOT_ALLOWED_USER_IDS=

# Optional: shared welcome message override.
# Currently only WeCom enter_chat events use it.
BOT_WELCOME_MESSAGE=

# WeCom settings
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret

# Optional: only allow specific Enterprise WeChat user IDs.
# Comma-separated. Ignored when BOT_ALLOWED_USER_IDS is set.
WECOM_ALLOWED_USER_IDS=

# Optional welcome message sent on enter_chat events.
WECOM_WELCOME_MESSAGE=你好，我已连接 OpenCode。请直接发送你的需求。

# Feishu settings
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret

# Optional: only allow specific Feishu user open_id values.
# Comma-separated. Ignored when BOT_ALLOWED_USER_IDS is set.
FEISHU_ALLOWED_OPEN_IDS=

# Optional file path for persisted bot conversation -> OpenCode session mapping.
SESSION_STORE_PATH=.data/sessions.json
