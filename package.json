{
  "name": "wecom-opencode-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge WeCom or Feishu long-connection bot messages to OpenCode sessions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
