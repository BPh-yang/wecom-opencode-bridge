    "start": "node dist/index.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@opencode-ai/sdk": "^1.0.0",
    "@wecom/aibot-node-sdk": "^1.0.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
